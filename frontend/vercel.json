{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "artfest.ro"
        }
      ],
      "destination": "https://www.artfest.ro/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/seo-colectie.js": {
      "includeFiles": "src/utils/seo/**"
    },
    "api/seo-categorie.js": {
      "includeFiles": "{src/utils/seo/**,src/constants/**}"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://artfest.onrender.com/sitemap.xml"
    },
    {
      "source": "/google-shopping-feed.xml",
      "destination": "https://artfest.onrender.com/google-shopping-feed.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "https://artfest.onrender.com/api/:path*"
    },
    {
      "source": "/legal/:path*",
      "destination": "https://artfest.onrender.com/legal/:path*"
    },
    {
      "source": "/termenii-si-conditiile",
      "destination": "https://artfest.onrender.com/termenii-si-conditiile"
    },
    {
      "source": "/confidentialitate",
      "destination": "https://artfest.onrender.com/confidentialitate"
    },
    {
      "source": "/cookies",
      "destination": "https://artfest.onrender.com/cookies"
    },
    {
      "source": "/acord-vanzatori",
      "destination": "https://artfest.onrender.com/acord-vanzatori"
    },
    {
      "source": "/acord-influenceri",
      "destination": "https://artfest.onrender.com/acord-influenceri"
    },
    {
      "source": "/politica-retur",
      "destination": "https://artfest.onrender.com/politica-retur"
    },
    {
      "source": "/anexa-expediere",
      "destination": "https://artfest.onrender.com/anexa-expediere"
    },
    {
      "source": "/anexa-produse",
      "destination": "https://artfest.onrender.com/anexa-produse"
    },
    {
      "source": "/produs/:id",
      "destination": "/api/seo-produs?id=:id"
    },
    {
      "source": "/magazin/:slug",
      "destination": "/api/seo-magazin?slug=:slug"
    },
    {
      "source": "/colectii",
      "destination": "/api/seo-colectie"
    },
    {
      "source": "/colectii/:slug",
      "destination": "/api/seo-colectie?slug=:slug"
    },
    {
      "source": "/categorii/:slug",
      "destination": "/api/seo-categorie?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}