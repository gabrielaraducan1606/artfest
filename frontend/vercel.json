{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://artfest.onrender.com/sitemap.xml"
    },
    {
      "source": "/google-shopping-feed.xml",
      "destination": "https://artfest.onrender.com/google-shopping-feed.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "https://artfest.onrender.com/api/:path*"
    },
    {
      "source": "/legal/:path*",
      "destination": "https://artfest.onrender.com/legal/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}